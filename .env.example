# =============================================================================
# Hospital Appointment API – Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env itself.
# For Docker secrets, use the *_FILE variant (path to mounted secret file).
# =============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=info               # debug | info | warning | error
APP_VERSION=0.1.0            # overridden by Docker build arg in CI

# --- Database ---
# Option A: full DSN (takes precedence if set)
DATABASE_URL=postgresql+psycopg://hospital:change_me@localhost:5432/hospital
# Option B: component vars (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hospital
# DB_USER=hospital
# DB_PASSWORD_FILE=/run/secrets/db_password   # Docker secret path

# --- Authentication ---
JWT_SECRET=change_me_to_a_random_string       # HMAC key for HS256 JWTs
# JWT_SECRET_FILE=/run/secrets/jwt_secret      # Docker secret path
JWT_EXPIRY_MINUTES=30                         # Token lifetime

# --- Seed data ---
SEED_PASSWORD=change_me_seed_password         # Password for synthetic users
# SEED_PASSWORD_FILE=/run/secrets/seed_password
RUN_SEED=false                                # Set true in dev/demo to auto-seed

# --- Slot configuration ---
SLOT_MINUTES=30              # Fixed appointment slot duration
WORK_START=09:00             # Clinic opens (HH:MM)
WORK_END=17:00               # Clinic closes (HH:MM)
TIMEZONE=Asia/Kolkata        # All slot times interpreted in this TZ

# --- Deployment ---
IMAGE_TAG=latest             # Used by docker compose; deploy.sh overrides this
